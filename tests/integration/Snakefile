# Emulate a user configuring the module.
configfile: workflow.source_path("./test_config.yaml")


# Import the module and configure it.
# `snakefile:` specifies the module. It can use file paths and special github(...) / gitlab(...) markers
# `config`: specifies the module configuration.
# `pathvars:` helps you re-wire where the module places files.
module module_euro_transport:
    pathvars:
        # Redirect intermediate files that are internal to the module
        logs="resources/module/logs",
        resources="resources/module/resources",
        results="resources/module/results",
    snakefile:
        "../../workflow/Snakefile"
    config:
        config["module_euro_transport"]


# rename all module rules with a prefix, to avoid naming conflicts.
use rule * from module_euro_transport as module_euro_transport_*


rule check_national_road_vkm:
    input:
        vkm="resources/module/resources/automatic/national_road_vkm.parquet",
    output:
        "results/checks/national_road_vkm.done",
    log:
        "resources/module/logs/check_national_road_vkm.log",
    conda:
        "../../workflow/envs/module.yaml"
    params:
        countries=config["module_euro_transport"]["countries"],
    message:
        "Check the combined national road vehicle-km for the test countries."
    script:
        "scripts/check_national_road_vkm.py"


rule check_national_road_stock:
    input:
        stock="resources/module/resources/automatic/national_road_stock.parquet",
    output:
        "results/checks/national_road_stock.done",
    log:
        "resources/module/logs/check_national_road_stock.log",
    conda:
        "../../workflow/envs/module.yaml"
    message:
        "Check the combined national road vehicle stock for the test countries."
    script:
        "scripts/check_national_road_stock.py"


# Request something from the module
rule all:
    default_target: True
    input:
        "results/checks/national_road_vkm.done",
        "results/checks/national_road_stock.done",
    message:
        "A generic test case for your module."
